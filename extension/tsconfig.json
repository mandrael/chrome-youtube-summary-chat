{
  "extends": "./.wxt/tsconfig.json",
  "include": [
    ".wxt/wxt.d.ts",
    "globals.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".output",
    ".wxt/types",
    "scripts/selfcheck.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "chrome"
    ]
  }
}
