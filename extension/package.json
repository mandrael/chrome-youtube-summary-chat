{
  "name": "chrome-youtube-summary-chat",
  "version": "0.3.1",
  "description": "Chat-Sidebar für YouTube-Videos: mit dem Transkript chatten, zusammenfassen, übersetzen – über OpenRouter.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "NODE_ENV=production wxt build --mode full",
    "build:store": "NODE_ENV=production wxt build --mode store",
    "zip": "NODE_ENV=production wxt zip --mode full",
    "zip:store": "NODE_ENV=production wxt zip --mode store",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "check": "node scripts/selfcheck.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.31",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "wxt": "^0.21.4"
  }
}
